{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ToppyMicroServices/agents-secure-binding/schemas/asb-human-relay-v1.schema.json",
  "title": "ASB Agent to Human relay v1 documents",
  "oneOf": [
    { "$ref": "#/$defs/intent" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\u0000-\u0020\u007F-\u00A0\u1680\u2000-\u200A\u2028-\u2029\u202F\u205F\u3000](?:[^\u0000-\u001F\u007F-\u009F]*[^\u0000-\u0020\u007F-\u00A0\u1680\u2000-\u200A\u2028-\u2029\u202F\u205F\u3000])?$",
      "description": "A case-sensitive identifier. Schema validation bounds Unicode code points and rejects control characters and surrounding Unicode whitespace. Semantic validation additionally limits the exact UTF-8 encoding to 256 octets; it performs no normalization or trimming.",
      "x-asb-maxUtf8Bytes": 256
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "eventID": {
      "type": "string",
      "pattern": "^relay-event:v1:[0-9a-f]{64}$"
    },
    "httpsReference": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$",
      "description": "An absolute HTTPS reference. Semantic validation additionally limits the exact UTF-8 encoding to 2048 octets and rejects control characters, userinfo, queries, and fragments.",
      "x-asb-maxUtf8Bytes": 2048
    },
    "channel": {
      "enum": ["EMAIL", "SNS", "TEL"]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "intent_id", "grant_id", "requester_participant_id",
        "purpose", "capability", "channel", "content_ref", "content_digest",
        "relay_session_ref", "actor_id", "authorization_id", "proof_id",
        "request_digest", "queued_at"
      ],
      "properties": {
        "schema": { "const": "asb.human-relay-intent/v1" },
        "intent_id": { "$ref": "#/$defs/identifier" },
        "grant_id": { "$ref": "#/$defs/identifier" },
        "requester_participant_id": { "$ref": "#/$defs/identifier" },
        "purpose": { "$ref": "#/$defs/identifier" },
        "capability": { "$ref": "#/$defs/identifier" },
        "channel": { "$ref": "#/$defs/channel" },
        "content_ref": { "$ref": "#/$defs/httpsReference" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "relay_session_ref": { "$ref": "#/$defs/httpsReference" },
        "actor_id": { "$ref": "#/$defs/identifier" },
        "authorization_id": { "$ref": "#/$defs/identifier" },
        "proof_id": { "$ref": "#/$defs/identifier" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "queued_at": { "type": "string", "format": "date-time" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "event_id", "intent_id", "status", "at"],
      "properties": {
        "schema": { "const": "asb.human-relay-event/v1" },
        "event_id": { "$ref": "#/$defs/eventID" },
        "intent_id": { "$ref": "#/$defs/identifier" },
        "status": {
          "enum": [
            "QUEUED", "DISPATCHING", "PROVIDER_ACKNOWLEDGED", "CANCELED"
          ]
        },
        "at": { "type": "string", "format": "date-time" },
        "provider_ack_ref": { "$ref": "#/$defs/identifier" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PROVIDER_ACKNOWLEDGED" } } },
          "then": { "required": ["provider_ack_ref"] },
          "else": { "not": { "required": ["provider_ack_ref"] } }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "intent_id", "grant_id", "status", "content_digest",
        "queued_at", "updated_at"
      ],
      "properties": {
        "schema": { "const": "asb.human-relay-receipt/v1" },
        "intent_id": { "$ref": "#/$defs/identifier" },
        "grant_id": { "$ref": "#/$defs/identifier" },
        "status": {
          "enum": [
            "QUEUED", "DISPATCHING", "PROVIDER_ACKNOWLEDGED", "CANCELED"
          ]
        },
        "content_digest": { "$ref": "#/$defs/digest" },
        "queued_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
