{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toppymicroservices.github.io/agents-secure-binding/schemas/asb-taskcoord-human-ingress-v1.schema.json",
  "title": "ASB TaskCoord Human Ingress v1",
  "description": "Wire envelopes for the TLS-terminating gateway-asserted-for-human operation ingress. The current profile authenticates the gateway Actor, not a Human-held key, and does not prove Human liveness, UI confirmation, or legal consent. Assurance is verifier-derived and is not a caller-controlled field. Schema validation does not replace signature, TLS exporter, registry, state, or replay verification.",
  "oneOf": [
    { "$ref": "#/$defs/challengeOffer" },
    { "$ref": "#/$defs/challengeTransition" },
    { "$ref": "#/$defs/challengeDelegation" },
    { "$ref": "#/$defs/challengeInteraction" },
    { "$ref": "#/$defs/executeOffer" },
    { "$ref": "#/$defs/executeTransition" },
    { "$ref": "#/$defs/executeDelegation" },
    { "$ref": "#/$defs/executeInteraction" }
  ],
  "$defs": {
    "challengeEnvelope": {
      "oneOf": [
        { "$ref": "#/$defs/challengeOffer" },
        { "$ref": "#/$defs/challengeTransition" },
        { "$ref": "#/$defs/challengeDelegation" },
        { "$ref": "#/$defs/challengeInteraction" }
      ]
    },
    "executeEnvelope": {
      "oneOf": [
        { "$ref": "#/$defs/executeOffer" },
        { "$ref": "#/$defs/executeTransition" },
        { "$ref": "#/$defs/executeDelegation" },
        { "$ref": "#/$defs/executeInteraction" }
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\u0000-\u0020\u007F-\u00A0\u1680\u2000-\u200A\u2028-\u2029\u202F\u205F\u3000](?:[^\u0000-\u001F\u007F-\u009F]*[^\u0000-\u0020\u007F-\u00A0\u1680\u2000-\u200A\u2028-\u2029\u202F\u205F\u3000])?$",
      "description": "A case-sensitive identifier. Schema validation bounds Unicode code points and rejects control characters and surrounding Unicode whitespace. Semantic validation additionally limits the exact UTF-8 encoding to 256 octets; it performs no normalization or trimming.",
      "x-asb-maxUtf8Bytes": 256
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\u0000-\u001F\u007F-\u009F]+$",
      "description": "An exact UTF-8 reference with no control characters. Semantic validation additionally limits its encoding to 2048 octets.",
      "x-asb-maxUtf8Bytes": 2048
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "detail": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\u0000-\u0008\u000B-\u001F\u007F-\u009F]*$",
      "x-asb-maxUtf8Bytes": 1024
    },
    "role": {
      "enum": ["OWNER", "ASSIGNEE", "REVIEWER"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "event_id",
        "task_id",
        "assignment_id",
        "target_participant_id",
        "role",
        "authority_digest"
      ],
      "properties": {
        "participant_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "task_id": { "$ref": "#/$defs/identifier" },
        "assignment_id": { "$ref": "#/$defs/identifier" },
        "target_participant_id": { "$ref": "#/$defs/identifier" },
        "role": { "$ref": "#/$defs/role" },
        "authority_digest": { "$ref": "#/$defs/digest" },
        "due_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "event_id",
        "task_id",
        "assignment_id",
        "operation",
        "expected_revision"
      ],
      "properties": {
        "participant_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "task_id": { "$ref": "#/$defs/identifier" },
        "assignment_id": { "$ref": "#/$defs/identifier" },
        "operation": {
          "enum": ["ACCEPT", "DECLINE", "RELEASE", "REVOKE", "FULFILL"]
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "detail": { "$ref": "#/$defs/detail" },
        "evidence_ref": { "$ref": "#/$defs/reference" }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "event_id",
        "parent_task_id",
        "parent_assignment_id",
        "expected_revision",
        "decision_id",
        "child_event_id",
        "child_task_id",
        "child_assignment_id",
        "target_participant_id",
        "role",
        "authority_digest"
      ],
      "properties": {
        "participant_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "parent_task_id": { "$ref": "#/$defs/identifier" },
        "parent_assignment_id": { "$ref": "#/$defs/identifier" },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "detail": { "$ref": "#/$defs/detail" },
        "evidence_ref": { "$ref": "#/$defs/reference" },
        "decision_id": { "$ref": "#/$defs/identifier" },
        "child_event_id": { "$ref": "#/$defs/identifier" },
        "child_task_id": { "$ref": "#/$defs/identifier" },
        "child_assignment_id": { "$ref": "#/$defs/identifier" },
        "target_participant_id": { "$ref": "#/$defs/identifier" },
        "role": { "$ref": "#/$defs/role" },
        "authority_digest": { "$ref": "#/$defs/digest" },
        "due_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "event_id",
        "interaction_id",
        "task_id",
        "assignment_id",
        "kind"
      ],
      "properties": {
        "participant_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/identifier" },
        "interaction_id": { "$ref": "#/$defs/identifier" },
        "task_id": { "$ref": "#/$defs/identifier" },
        "assignment_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["QUESTION", "RESPONSE", "CORRECTION", "WITHDRAWAL"]
        },
        "in_reply_to": { "$ref": "#/$defs/identifier" },
        "supersedes": { "$ref": "#/$defs/identifier" },
        "finality": {
          "enum": ["INTERIM", "FINAL"]
        },
        "content_ref": { "$ref": "#/$defs/reference" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "evidence_ref": { "$ref": "#/$defs/reference" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "QUESTION" } }, "required": ["kind"] },
          "then": {
            "required": ["content_ref", "content_digest"],
            "not": {
              "anyOf": [
                { "required": ["supersedes"] },
                { "required": ["finality"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "RESPONSE" } }, "required": ["kind"] },
          "then": {
            "required": ["in_reply_to", "finality", "content_ref", "content_digest"],
            "not": { "required": ["supersedes"] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "CORRECTION" } }, "required": ["kind"] },
          "then": {
            "required": ["in_reply_to", "supersedes", "finality", "content_ref", "content_digest"]
          }
        },
        {
          "if": { "properties": { "kind": { "const": "WITHDRAWAL" } }, "required": ["kind"] },
          "then": {
            "required": ["in_reply_to", "supersedes"],
            "not": {
              "anyOf": [
                { "required": ["finality"] },
                { "required": ["content_ref"] },
                { "required": ["content_digest"] }
              ]
            }
          }
        }
      ]
    },
    "challengeOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request"],
      "properties": {
        "operation": { "const": "ASSIGNMENT_OFFER" },
        "request": { "$ref": "#/$defs/offer" }
      }
    },
    "challengeTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request"],
      "properties": {
        "operation": { "const": "ASSIGNMENT_TRANSITION" },
        "request": { "$ref": "#/$defs/transition" }
      }
    },
    "challengeDelegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request"],
      "properties": {
        "operation": { "const": "ASSIGNMENT_DELEGATION" },
        "request": { "$ref": "#/$defs/delegation" }
      }
    },
    "challengeInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request"],
      "properties": {
        "operation": { "const": "INTERACTION_APPEND" },
        "request": { "$ref": "#/$defs/interaction" }
      }
    },
    "executeBase": {
      "type": "object",
      "required": [
        "challenge_id",
        "operation",
        "request",
        "grant_jwt",
        "session_binding_jwt"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "grant_jwt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "session_binding_jwt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      }
    },
    "executeOffer": {
      "allOf": [
        { "$ref": "#/$defs/executeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "challenge_id",
            "operation",
            "request",
            "grant_jwt",
            "session_binding_jwt"
          ],
          "properties": {
            "challenge_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "operation": { "const": "ASSIGNMENT_OFFER" },
            "request": { "$ref": "#/$defs/offer" },
            "grant_jwt": { "type": "string", "minLength": 1, "maxLength": 262144 },
            "session_binding_jwt": { "type": "string", "minLength": 1, "maxLength": 262144 }
          }
        }
      ]
    },
    "executeTransition": {
      "allOf": [
        { "$ref": "#/$defs/executeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "challenge_id",
            "operation",
            "request",
            "grant_jwt",
            "session_binding_jwt"
          ],
          "properties": {
            "challenge_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "operation": { "const": "ASSIGNMENT_TRANSITION" },
            "request": { "$ref": "#/$defs/transition" },
            "grant_jwt": { "type": "string", "minLength": 1, "maxLength": 262144 },
            "session_binding_jwt": { "type": "string", "minLength": 1, "maxLength": 262144 }
          }
        }
      ]
    },
    "executeDelegation": {
      "allOf": [
        { "$ref": "#/$defs/executeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "challenge_id",
            "operation",
            "request",
            "grant_jwt",
            "session_binding_jwt"
          ],
          "properties": {
            "challenge_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "operation": { "const": "ASSIGNMENT_DELEGATION" },
            "request": { "$ref": "#/$defs/delegation" },
            "grant_jwt": { "type": "string", "minLength": 1, "maxLength": 262144 },
            "session_binding_jwt": { "type": "string", "minLength": 1, "maxLength": 262144 }
          }
        }
      ]
    },
    "executeInteraction": {
      "allOf": [
        { "$ref": "#/$defs/executeBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "challenge_id",
            "operation",
            "request",
            "grant_jwt",
            "session_binding_jwt"
          ],
          "properties": {
            "challenge_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "operation": { "const": "INTERACTION_APPEND" },
            "request": { "$ref": "#/$defs/interaction" },
            "grant_jwt": { "type": "string", "minLength": 1, "maxLength": 262144 },
            "session_binding_jwt": { "type": "string", "minLength": 1, "maxLength": 262144 }
          }
        }
      ]
    }
  }
}
